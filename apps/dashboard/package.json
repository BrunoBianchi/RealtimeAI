{
  "name": "realtimeai-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "lipcue.com: interview copilot dashboard, session manager and overlay control",
  "author": {
    "name": "Bruno Raiado Bianchi"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; require('child_process').spawn(require('electron'), ['.', ...process.argv.slice(1)], {stdio:'inherit'}).on('exit', c => process.exit(c || 0))\" --",
    "build:css": "node ../../scripts/run-tailwind-css.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "flags:validate": "node ../../scripts/validate-flags.mjs",
    "dist": "npm run build:css && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build:css && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "driver.js": "1.10.2",
    "electron-updater": "^6.6.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "caniuse-lite": "^1.0.30001820",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=20"
  }
}
