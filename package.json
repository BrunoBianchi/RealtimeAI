{
  "name": "realtimeai",
  "version": "2.0.0",
  "private": true,
  "description": "RealTimeAI: real-time meeting and interview copilot (native C++ overlay + Electron dashboard)",
  "author": "Bruno Raiado Bianchi",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrunoBianchi/RealtimeAI.git"
  },
  "scripts": {
    "prepare": "husky",
    "setup": "npm ci && npm --prefix apps/dashboard ci",
    "dev": "npm --prefix apps/dashboard start",
    "build:native": "cmake --preset windows-release && cmake --build --preset windows-release",
    "package": "scripts\\windows\\package.bat",
    "build:css": "npm --prefix apps/dashboard run build:css",
    "test": "npm run test:scripts && npm run test:dashboard",
    "test:dashboard": "npm --prefix apps/dashboard test",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "test:native": "ctest --preset windows-release",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "check:staged": "node scripts/check-secrets.mjs --staged",
    "flags:validate": "node scripts/validate-flags.mjs",
    "version:next": "node scripts/version.mjs --json --pre beta",
    "version:notes": "node scripts/version.mjs notes",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
