# Normalize text to LF in the repository; Windows scripts keep CRLF on checkout.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf
*.vcxproj text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.wav  binary
*.onnx binary
*.exe  binary
*.dll  binary
*.zip  binary

# Generated files: collapsed in diffs and ignored by GitHub language stats
package-lock.json                     -diff linguist-generated=true
apps/dashboard/src/renderer/styles.css   linguist-generated=true
.kiro/**                              linguist-documentation=true
